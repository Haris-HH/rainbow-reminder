# ============================================================
# Supabase — หาได้ที่ Project Settings
# ============================================================

# Project URL: Settings > Data API > Project URL (หรือปุ่ม "Connect" บน dashboard)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Publishable / anon key: Settings > API Keys
#  - แบบใหม่ (แนะนำ): แท็บ "Publishable and secret" > Publishable key -> sb_publishable_...
#  - แบบเก่า (legacy): แท็บ "Legacy anon, service_role" > anon public -> eyJ...
# ใช้ตัวใดตัวหนึ่ง ปลอดภัยที่จะอยู่ใน frontend เพราะเปิด RLS แล้ว
# ⚠️ ห้ามใช้ secret / service_role key ที่นี่เด็ดขาด
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
